<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.restaurante</groupId>
    <artifactId>pedidos-hexagonal-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>monolito</artifactId>
  <packaging>jar</packaging>
  <name>Módulo Monolito</name>

  <properties>
    <!-- Clase que arranca "mvn compile exec:java". Para la consola:
         mvn compile exec:java -Dexec.mainClass=com.restaurante.infrastructure.in.cli.Main -->
    <exec.mainClass>com.restaurante.infrastructure.in.web.MainWeb</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.restaurante</groupId>
      <artifactId>comun</artifactId>
    </dependency>
    <!-- Solo para pruebas: las pruebas de la API levantan el servicio de Menú real para que
         Órdenes lo consulte por REST. El código de Órdenes no depende de este módulo. -->
    <dependency>
      <groupId>com.restaurante</groupId>
      <artifactId>servicio-menu</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- "mvn package" genera un jar ejecutable con sus dependencias: java -jar monolito/target/monolito-0.1.0.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${exec.mainClass}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Permite ejecutar la aplicación con "mvn compile exec:java" (por defecto, el servidor web) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
    </plugins>
  </build>
</project>